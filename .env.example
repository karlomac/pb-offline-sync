# Copy to .env and fill in. Read by `docker compose`, and put the same keys in
# the Dokploy application's Environment editor for a Dokploy deploy.
#
# !! NEVER COMMIT the filled-in .env — it holds the admin password and is
# !! already listed in .gitignore.

# Superuser created (idempotently) on every boot by docker-entrypoint.sh.
PB_ADMIN_EMAIL=you@example.com
# Required — set a strong password (there is no default on purpose).
PB_ADMIN_PASSWORD=

# Build-time PocketBase version, e.g. v0.40.6. Leave BLANK to use the version
# pinned in server/go.mod. Note this differs from the upstream "blank = latest"
# convention on purpose: the plugin's change-log/hook behaviour is only verified
# against the pinned version, so an arbitrary version is untested.
PB_VERSION=

# Absolute path on the Dokploy host where PocketBase data lives. Use a unique
# path per application so data is preserved across redeploys and restarts, e.g.
#   /etc/dokploy/storage/<app-name>/pb_data
PB_DATA_PATH=/etc/dokploy/storage/pb-sync/pb_data

# Optional: encrypt PocketBase settings at rest (SMTP/OAuth secrets).
# PB_ENCRYPTION_KEY=change-me-to-a-long-random-value

# Optional: listen address inside the container.
# PB_HTTP_ADDR=0.0.0.0:8090

# Sync plugin configuration (README Part 1, Option A).
# Collections must already exist and have the owner field as a relation to an
# auth collection, or the server refuses to start.
SYNC_COLLECTIONS=notes
SYNC_OWNER_FIELD=owner
# SYNC_CONFLICT=serverWins        # serverWins | clientWins | reject
# SYNC_DELETE_POLICY=deleteWins   # deleteWins | editWins
# SYNC_PRUNE_CRON=0 3 * * *

# Media sync (protocol §18). Leave SYNC_MEDIA_COLLECTION empty to keep it off.
# The collection must have Protected file fields and owner-scoped list/view
# rules (see README "Media sync"); the server validates this at boot.
# SYNC_MEDIA_COLLECTION=media
# SYNC_MEDIA_MAX_FILE_BYTES=52428800
# SYNC_MEDIA_PER_USER_QUOTA=1073741824
# SYNC_MEDIA_MIME_ALLOWLIST=image/,video/

# Optional signup gating (server/authplugin). Leave AUTH_SIGNUP_MODE empty to
# keep it off.
# AUTH_SIGNUP_MODE=password          # oauth | password | both
# AUTH_COLLECTION=users
# AUTH_TURNSTILE_SECRET=
# AUTH_TURNSTILE_HOSTNAMES=app.example.com
# AUTH_ALLOWED_EMAIL_DOMAINS=example.com
# AUTH_DISPOSABLE_DOMAINS=mailinator.com
