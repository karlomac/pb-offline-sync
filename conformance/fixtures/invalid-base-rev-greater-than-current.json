{
  "name": "invalid-base-rev-greater-than-current",
  "description": "An update whose baseRev is greater than the current rev is rejected with invalid_base_rev.",
  "config": {
    "collections": {
      "notes": {
        "ownerField": "owner",
        "conflictPolicy": "serverWins",
        "deletePolicy": "deleteWins",
        "fields": [
          { "name": "title", "type": "text", "writable": true },
          { "name": "body", "type": "editor", "writable": true },
          { "name": "attachments", "type": "file", "writable": false }
        ]
      }
    }
  },
  "users": ["alice"],
  "steps": [
    {
      "as": "alice",
      "push": { "mutations": [
        { "id": "m1", "collection": "notes", "recordId": "notesrecord0001", "op": "create", "fields": { "title": "t", "body": "b" } }
      ] },
      "expect": { "results": [ { "id": "m1", "status": "ok", "rev": 1 } ] }
    },
    {
      "as": "alice",
      "push": { "mutations": [
        { "id": "m2", "collection": "notes", "recordId": "notesrecord0001", "op": "update", "baseRev": 5, "fields": { "title": "t2" } }
      ] },
      "expect": { "results": [
        { "id": "m2", "status": "rejected", "code": "invalid_base_rev" }
      ] }
    }
  ]
}
