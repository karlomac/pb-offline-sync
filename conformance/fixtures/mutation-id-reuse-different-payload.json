{
  "name": "mutation-id-reuse-different-payload",
  "description": "Reusing a mutation ID with a different payload is rejected with mutation_id_reuse.",
  "config": {
    "collections": {
      "notes": {
        "ownerField": "owner",
        "conflictPolicy": "serverWins",
        "deletePolicy": "deleteWins",
        "fields": [
          { "name": "title", "type": "text", "writable": true },
          { "name": "body", "type": "editor", "writable": true },
          { "name": "attachments", "type": "file", "writable": false }
        ]
      }
    }
  },
  "users": ["alice"],
  "steps": [
    {
      "as": "alice",
      "push": { "mutations": [
        { "id": "m1", "collection": "notes", "recordId": "notesrecord0001", "op": "create", "fields": { "title": "first", "body": "hello" } }
      ] },
      "expect": { "results": [
        { "id": "m1", "status": "ok", "rev": 1 }
      ] }
    },
    {
      "as": "alice",
      "push": { "mutations": [
        { "id": "m1", "collection": "notes", "recordId": "notesrecord0001", "op": "create", "fields": { "title": "different", "body": "hello" } }
      ] },
      "expect": { "results": [
        { "id": "m1", "status": "rejected", "code": "mutation_id_reuse" }
      ] }
    }
  ]
}
