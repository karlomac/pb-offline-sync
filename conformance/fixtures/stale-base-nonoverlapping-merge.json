{
  "name": "stale-base-nonoverlapping-merge",
  "description": "A stale baseRev with non-overlapping fields is applied as a merge (ok, merged true).",
  "config": {
    "collections": {
      "notes": {
        "ownerField": "owner",
        "conflictPolicy": "serverWins",
        "deletePolicy": "deleteWins",
        "fields": [
          { "name": "title", "type": "text", "writable": true },
          { "name": "body", "type": "editor", "writable": true },
          { "name": "attachments", "type": "file", "writable": false }
        ]
      }
    }
  },
  "users": ["alice", "bob"],
  "steps": [
    {
      "as": "alice",
      "push": { "mutations": [
        { "id": "m1", "collection": "notes", "recordId": "aaaaaaaaaaaaaaa", "op": "create", "fields": { "title": "t", "body": "b"  } }
      ] },
      "expect": { "results": [
        { "id": "m1", "status": "ok", "rev": 1 }
      ] }
    },
    {
      "as": "alice",
      "push": { "mutations": [
        { "id": "m2", "collection": "notes", "recordId": "aaaaaaaaaaaaaaa", "op": "update", "baseRev": 1, "fields": { "title": "t2" } }
      ] },
      "expect": { "results": [
        { "id": "m2", "status": "ok", "rev": 2 }
      ] }
    },
    {
      "as": "alice",
      "push": { "mutations": [
        { "id": "m3", "collection": "notes", "recordId": "aaaaaaaaaaaaaaa", "op": "update", "baseRev": 1, "fields": { "body": "b2" } }
      ] },
      "expect": { "results": [
        { "id": "m3", "status": "ok", "rev": 3, "merged": true, "record": { "id": "aaaaaaaaaaaaaaa", "title": "t2", "body": "b2" } }
      ] }
    }
  ]
}
