{
  "name": "duplicate-mutation-id-same-payload",
  "description": "Resending a mutation ID with the same payload returns duplicate carrying the original stored result.",
  "config": {
    "collections": {
      "notes": {
        "ownerField": "owner",
        "conflictPolicy": "serverWins",
        "deletePolicy": "deleteWins",
        "fields": [
          { "name": "title", "type": "text", "writable": true },
          { "name": "body", "type": "editor", "writable": true },
          { "name": "attachments", "type": "file", "writable": false }
        ]
      }
    }
  },
  "users": ["alice"],
  "steps": [
    {
      "as": "alice",
      "push": { "mutations": [
        { "id": "m1", "collection": "notes", "recordId": "notesrecord0001", "op": "create", "fields": { "title": "first", "body": "hello" } }
      ] },
      "expect": { "results": [
        { "id": "m1", "status": "ok", "rev": 1 }
      ] }
    },
    {
      "as": "alice",
      "push": { "mutations": [
        { "id": "m1", "collection": "notes", "recordId": "notesrecord0001", "op": "create", "fields": { "title": "first", "body": "hello" } }
      ] },
      "expect": { "results": [
        { "id": "m1", "status": "duplicate", "rev": 1, "record": { "id": "notesrecord0001", "title": "first" } }
      ] }
    }
  ]
}
